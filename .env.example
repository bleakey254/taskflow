# Environment variables for TaskFlow
DATABASE_URL="postgresql://user:password@localhost:5432/taskflow"
AUTH_SECRET="replace-with-a-secure-random-secret"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_BUSINESS_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="http://localhost:3000/api/webhooks/mpesa"

# Task unlock charges are simulated outside production unless MPESA_SIMULATE
# is set to "false". Set it to "false" to refuse unlocking until a provider is wired.
MPESA_SIMULATE="true"
# Shared secret for POST /api/webhooks/mpesa (x-mpesa-signature header,
# Bearer token, or ?secret=). While this is empty the webhook rejects every
# callback with 503 instead of accepting unauthenticated requests.
MPESA_WEBHOOK_SECRET=""
