datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  WORKER
  CLIENT
  ADMIN
}

enum TaskStatus {
  DRAFT
  SUBMITTED_FOR_APPROVAL
  APPROVED
  PUBLISHED
  VIEWED
  UNLOCKED
  IN_PROGRESS
  SUBMITTED
  REVIEWING
  APPROVED_BY_REVIEWER
  REJECTED
  COMPLETED
  DISPUTED
  CANCELLED
}

enum PaymentPurpose {
  TASK_UNLOCK
  WITHDRAWAL
  REFUND
  ADJUSTMENT
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum WalletTransactionType {
  TASK_EARNING
  WITHDRAWAL
  REFUND
  ADJUSTMENT
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum NotificationType {
  TASK_APPROVED
  TASK_REJECTED
  TASK_PUBLISHED
  NEW_MESSAGE
  WITHDRAWAL_SUCCESS
  WITHDRAWAL_FAILURE
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  SYSTEM_UPDATE
}

enum AdminActionType {
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  TASK_CREATED
  TASK_UPDATED
  TASK_DELETED
  TASK_APPROVED
  TASK_REJECTED
  TASK_PUBLISHED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  SYSTEM_UPDATE
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                    String   @id @default(uuid())
  email                 String   @unique
  password              String
  name                  String
  role                  Role
  status                String   @default("ACTIVE")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  workerProfile         WorkerProfile?
  clientProfile         ClientProfile?
  wallet                Wallet?
  payments              Payment[]
  submissions           Submission[] @relation("SubmissionWorker")
  reviews               SubmissionReview[]
  reviewedSubmissions   Submission[] @relation("SubmissionReviewer")
  createdTasks          Task[] @relation("ClientTasks")
  taskViews             TaskView[]
  taskUnlocks           TaskUnlock[]
  disputesAsClaimant    Dispute[] @relation("DisputeClaimant")
  disputesAsRespondent  Dispute[] @relation("DisputeRespondent")
  notifications         Notification[]
  adminActions          AdminAction[] @relation("AdminActionActor")
  auditLogs             AuditLog[] @relation("AuditLogActor")
  conversations         Conversation[] @relation("ConversationParticipants")
  messages              Message[] @relation("MessageSender")
  messageReads          MessageRead[] @relation("MessageReadUser")
  sessions              Session[]

  @@index([role])
  @@index([status])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  tokenHash    String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model WorkerProfile {
  id      String   @id @default(uuid())
  user    User     @relation(fields: [userId], references: [id])
  userId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClientProfile {
  id      String   @id @default(uuid())
  user    User     @relation(fields: [userId], references: [id])
  userId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  description String?
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id                  String   @id @default(uuid())
  title               String
  description         String
  previewDescription  String
  category            TaskCategory @relation(fields: [categoryId], references: [id])
  categoryId          String
  client              User       @relation("ClientTasks", fields: [clientId], references: [id])
  clientId            String
  budget              Decimal    @db.Decimal(10, 2)
  currency            String     @default("USD")
  status              TaskStatus @default(DRAFT)
  deadline            DateTime?
  requirements        Json?
  attachments         Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  approvedAt          DateTime?
  publishedAt         DateTime?
  completedAt         DateTime?
  views               TaskView[]
  unlocks             TaskUnlock[]
  submissions         Submission[]
  payments            Payment[] @relation("TaskPayments")
  disputes            Dispute[]
  @@index([categoryId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
  @@index([deadline])
}

model TaskView {
  id        String   @id @default(uuid())
  task      Task     @relation(fields: [taskId], references: [id])
  taskId    String
  worker    User     @relation(fields: [workerId], references: [id])
  workerId  String
  viewedAt  DateTime @default(now())
  @@unique([taskId, workerId])
  @@index([taskId])
  @@index([workerId])
  @@index([viewedAt])
}

model TaskUnlock {
  id        String   @id @default(uuid())
  task      Task     @relation(fields: [taskId], references: [id])
  taskId    String
  worker    User     @relation(fields: [workerId], references: [id])
  workerId  String
  payment   Payment  @relation(fields: [paymentId], references: [id])
  paymentId String
  // Progress for this worker on this task. Task.status stays a rollup so one
  // worker's progress never changes what another worker sees.
  status    TaskStatus @default(UNLOCKED)
  unlockedAt DateTime @default(now())
  @@unique([taskId, workerId])
  @@index([taskId])
  @@index([workerId])
  @@index([paymentId])
}

model Payment {
  id                  String   @id @default(uuid())
  user                User     @relation(fields: [userId], references: [id])
  userId              String
  task                Task?    @relation(fields: [taskId], references: [id], name: "TaskPayments")
  taskId              String?
  taskUnlocks         TaskUnlock[]
  amount              Decimal    @db.Decimal(10, 2)
  currency            String     @default("USD")
  purpose             PaymentPurpose
  provider            String     // e.g., "MPESA", "CARD"
  providerTransactionId String   @unique
  internalTransactionId String   @unique
  status              PaymentStatus
  idempotencyKey      String   @unique
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  @@index([userId])
  @@index([taskId])
  @@index([status])
  @@index([providerTransactionId])
  @@index([internalTransactionId])
  @@index([idempotencyKey])
}

model Submission {
  id              String   @id @default(uuid())
  task            Task     @relation(fields: [taskId], references: [id])
  taskId          String
  worker          User     @relation("SubmissionWorker", fields: [workerId], references: [id])
  workerId        String
  content         String
  attachments     Json?
  status          SubmissionStatus @default(PENDING)
  submittedAt     DateTime @default(now())
  reviewedAt      DateTime?
  reviewer        User?    @relation("SubmissionReviewer", fields: [reviewerId], references: [id])
  reviewerId      String?
  feedback        String?
  review          SubmissionReview?
  disputes        Dispute[]
  @@index([taskId])
  @@index([workerId])
  @@index([status])
}

model SubmissionReview {
  id            String   @id @default(uuid())
  submission    Submission @relation(fields: [submissionId], references: [id])
  submissionId  String   @unique
  reviewer      User     @relation(fields: [reviewerId], references: [id])
  reviewerId    String
  feedback      String
  rating        Int?     // Optional rating 1-5
  createdAt     DateTime @default(now())
  @@index([submissionId])
  @@index([reviewerId])
}

model Wallet {
  id        String   @id @default(uuid())
  worker    User     @relation(fields: [workerId], references: [id])
  workerId  String   @unique
  balance   Decimal    @db.Decimal(10, 2) @default(0)
  transactions WalletTransaction[]
  withdrawals Withdrawal[]
  @@index([workerId])
}

model WalletTransaction {
  id            String   @id @default(uuid())
  wallet        Wallet   @relation(fields: [walletId], references: [id])
  walletId      String
  type          WalletTransactionType
  amount        Decimal    @db.Decimal(10, 2)
  referenceId   String?
  referenceType String?
  metadata      Json?
  createdAt     DateTime @default(now())
  @@index([walletId])
  @@index([type])
  @@index([createdAt])
}

model Withdrawal {
  id            String   @id @default(uuid())
  wallet        Wallet   @relation(fields: [walletId], references: [id])
  walletId      String
  amount        Decimal    @db.Decimal(10, 2)
  method        String     // e.g., "MPESA", "BANK_TRANSFER"
  destination   String     // Phone number, bank account, etc.
  status        WithdrawalStatus @default(PENDING)
  providerReference String?
  failureReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([walletId])
  @@index([status])
  @@index([createdAt])
}

model Dispute {
  id              String   @id @default(uuid())
  task            Task     @relation(fields: [taskId], references: [id])
  taskId          String
  submission      Submission? @relation(fields: [submissionId], references: [id])
  submissionId    String?
  claimant        User     @relation("DisputeClaimant", fields: [claimantId], references: [id])
  claimantId      String
  respondent      User?    @relation("DisputeRespondent", fields: [respondentId], references: [id])
  respondentId    String?
  status          DisputeStatus @default(OPEN)
  reason          String
  resolution      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([taskId])
  @@index([submissionId])
  @@index([claimantId])
  @@index([respondentId])
  @@index([status])
}

model Notification {
  id              String   @id @default(uuid())
  recipient       User     @relation(fields: [recipientId], references: [id])
  recipientId     String
  type            NotificationType
  title           String
  message         String
  read            Boolean  @default(false)
  relatedEntityType String?
  relatedEntityId   String?
  createdAt       DateTime @default(now())
  @@index([recipientId])
  @@index([read])
  @@index([createdAt])
}

model AdminAction {
  id            String   @id @default(uuid())
  actor         User     @relation("AdminActionActor", fields: [actorId], references: [id])
  actorId       String
  action        AdminActionType
  entityType    String
  entityId      String
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  @@index([actorId])
  @@index([entityType])
  @@index([createdAt])
}

model AuditLog {
  id            String   @id @default(uuid())
  actor         User?    @relation("AuditLogActor", fields: [actorId], references: [id])
  actorId       String?
  action        String
  entityType    String
  entityId      String
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  @@index([actorId])
  @@index([entityType])
  @@index([createdAt])
}

model Conversation {
  id            String   @id @default(uuid())
  participants  User[]   @relation("ConversationParticipants")
  messages      Message[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([updatedAt])
}

model Message {
  id            String   @id @default(uuid())
  conversation  Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  sender        User     @relation("MessageSender", fields: [senderId], references: [id])
  senderId      String
  content       String
  attachments   Json?
  reads         MessageRead[]
  createdAt     DateTime @default(now())
  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model MessageRead {
  id            String   @id @default(uuid())
  message       Message  @relation(fields: [messageId], references: [id])
  messageId     String
  user          User     @relation("MessageReadUser", fields: [userId], references: [id])
  userId        String
  readAt        DateTime @default(now())
  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}